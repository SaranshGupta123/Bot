# ==============================================================================
# RAINFALL DISCORD MUSIC ECOSYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure all variables accordingly.
# NEVER commit your actual .env file or credentials to version control.

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Discord Application Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_DEFAULT_PREFIX=!

# Discord Bot Owner & Developer IDs (Comma separated)
DEVELOPER_USER_IDS=123456789012345678,987654321098765432

# Database (PostgreSQL)
DATABASE_URL=postgresql://rainfall:rainfall_password@localhost:5432/rainfall_db?schema=public

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Lavalink v4 Audio Cluster Configuration
# Primary Node
LAVALINK_NODE_1_HOST=localhost
LAVALINK_NODE_1_PORT=2333
LAVALINK_NODE_1_PASSWORD=youshallnotpass
LAVALINK_NODE_1_SECURE=false
LAVALINK_NODE_1_ID=Main-Node-1

# Spotify API Credentials (Used for metadata resolution)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# API & Backend Server
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
JWT_SECRET=super_secret_jwt_random_key_change_in_production_min32chars

# Web Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_application_client_id_here
NEXT_PUBLIC_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=your_discord_application_client_id_here&permissions=3233856&scope=bot%20applications.commands
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=another_super_secret_key_change_in_production